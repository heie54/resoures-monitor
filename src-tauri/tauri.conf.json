{
  "$schema": "https://v2.tauri.app/schemas/desktop.schema.json",
  "identifier": "com.resource-monitor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "powershell -NoProfile -Command \"Remove-Item Env:TAURI_PLATFORM -ErrorAction SilentlyContinue; npm run build\""
  },
  "app": {
    "windows": [
      {
        "title": "Resource Monitor",
        "width": 350,
        "height": 158,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
